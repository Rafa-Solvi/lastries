  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
