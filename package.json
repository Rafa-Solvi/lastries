{
  "name": "lastries",
  "version": "1.0.0",
  "private": true,
  "description": "Registro personal de entrenamiento de fuerza y alimentación (PWA local)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gen-sw-manifest.ts",
